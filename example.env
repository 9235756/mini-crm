# =====================================================================
#  Мини-CRM — настройки. Скопируйте файл:  copy example.env .env
#  Файл .env в git не попадает (см. .gitignore).
# =====================================================================

# ===== РЕЖИМ РАБОТЫ С GOOGLE =====
# mock — эмуляция (ключи не нужны, отчёты пишутся в ./mock_drive в формате .xlsx + .html)
# real — настоящие Google Drive API и Google Sheets API
GOOGLE_MODE=mock

# ===== GOOGLE CLOUD (нужно только для GOOGLE_MODE=real) =====
# 1. https://console.cloud.google.com/ → создать проект (кнопка выбора проекта → New Project)
# 2. APIs & Services → Library → найти и включить "Google Drive API" и "Google Sheets API"
# 3. APIs & Services → OAuth consent screen → User type: External → заполнить название
#    приложения и email → на шаге "Test users" нажать "Add users" и добавить свой Gmail
#    (без этого вход завершится ошибкой 403 access_denied: приложение в режиме тестирования)
# 4. APIs & Services → Credentials → Create Credentials → OAuth client ID →
#    Application type: Desktop app → Create → Download JSON
#    и положить файл как google_integration/client_secret.json
#    (или выбрать файл в GUI: кнопка «Настройки Google» → «Выбрать…»)
GOOGLE_CLIENT_SECRET_FILE=google_integration/client_secret.json

# Файл токена создаётся автоматически после первой авторизации в браузере.
# Чтобы войти под другим аккаунтом — просто удалите token.json.
GOOGLE_TOKEN_FILE=google_integration/token.json

# (опционально) сервисный аккаунт — используется, только если client_secret.json не найден:
# IAM & Admin → Service Accounts → Create service account → открыть его →
# Keys → Add key → Create new key → JSON. Папку на Диске нужно «поделиться» с email
# сервисного аккаунта (xxx@project.iam.gserviceaccount.com) с правами редактора.
# Учтите: у сервисного аккаунта нет своей квоты на Диске — для личного Gmail надёжнее OAuth.
GOOGLE_SERVICE_ACCOUNT_FILE=google_integration/service_account.json

# ID папки на Google Drive: открыть папку в браузере → часть URL после /folders/
#   https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz  →  1AbCdEfGhIjKlMnOpQrStUvWxYz
# Можно оставить как есть — тогда отчёты лягут в корень «Моего диска».
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Права доступа, которые запрашиваются при входе (через запятую).
# После изменения списка удалите token.json, чтобы войти заново.
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/spreadsheets

# ===== BACKEND =====
# Адрес API для GUI и скриптов
API_URL=http://localhost:8000
# Путь к базе для локального запуска без Docker (в контейнере задаётся в docker-compose.yml)
DATABASE_PATH=data/crm.db
